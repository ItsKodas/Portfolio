# Copy to mail/.env and fill in. mail/.env is gitignored and must never be committed.
#
# This file is shared by both services. The Cloudflare credentials are deliberately NOT here: they
# live in mail/.env.mailops, which only the mailops container reads. See mail/.env.mailops.example.

MAIL_DOMAIN=dev.horizons.gg

# The part before the @ of the one address this server accepts, so info here means info@MAIL_DOMAIN.
# Just the local part, never the full address. Defaults to contact when unset. The mail account you
# create after first start (see RUNBOOK.md) must be this same address.
MAIL_ADDRESS=info

FORWARD_TO=you@example.com
DMARC_RUA=you@example.com
DELIVERY_TARGETS=forward

# Accept mail for every address at MAIL_DOMAIN, not just MAIL_ADDRESS. Off by default, and leaving it off
# is strongly recommended. On a forward-only server a catch-all means every dictionary-attack
# recipient is accepted and re-sent to FORWARD_TO from an address that is permanently on the PBL,
# which risks your own provider rate-limiting the single delivery path this design depends on.
ACCEPT_CATCHALL=0

# Leave RELAY_HOST empty to deliver direct. Setting it switches outbound to an authenticated relay and
# adds the include to SPF automatically. RELAY_SPF_INCLUDE is required whenever RELAY_HOST is set.
RELAY_HOST=
RELAY_PORT=587
RELAY_USER=
RELAY_PASSWORD=
RELAY_SPF_INCLUDE=
