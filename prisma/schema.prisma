// The quotes feature's tables. The enum values match server/quotes/labels.ts (a test checks that).

generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  // Extensionless imports inside the generated client, which Next's bundler and Vitest both resolve
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  NEW
  REPLIED
  WON
  LOST
}

enum ProjectType {
  NEW_SITE
  REDESIGN
  WEB_APP
  ONLINE_STORE
  OTHER
}

enum Budget {
  UNDER_2K
  FROM_2K_TO_5K
  FROM_5K_TO_10K
  OVER_10K
  NOT_SURE
}

enum Timeline {
  ASAP
  ONE_TO_THREE_MONTHS
  OVER_THREE_MONTHS
  FLEXIBLE
}

model Quote {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  name           String
  email          String
  company        String?
  website        String?
  projectType    ProjectType?
  budget         Budget?
  timeline       Timeline?
  message        String
  referenceSites String[]
  status         QuoteStatus  @default(NEW)
  archivedAt     DateTime?
  // When the email to Koda went
  notifiedAt     DateTime?
  // When the confirmation to the prospect went
  confirmedAt    DateTime?
  // HMAC of the sender's IP, for the rate limit; the IP itself is never stored
  ipHash         String
  notes          Note[]
  // SetNull, not Cascade: deleting a client must never delete the quote they came from
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId       String?

  @@index([ipHash, createdAt])
  @@index([archivedAt, createdAt])
  @@index([clientId])
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  body      String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId   String

  @@index([quoteId])
}

// The client accounts feature's tables. See docs/superpowers/specs/2026-09-20-client-accounts-design.md.

enum ClientTokenPurpose {
  INVITE
  PASSWORD_RESET
}

model Client {
  // "cl_" + 8 Crockford base32 chars, generated by server/clients/ids.ts. It is the primary key rather than a
  // second column because hostd's registry names clients by it, and two ids would be two things to keep in step.
  id                String    @id
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  name              String
  company           String?
  email             String    @unique
  // Null until the invite is completed. There is deliberately no status column: a status could say ACTIVE while
  // this is null, and that state must not be representable.
  passwordHash      String?
  passwordUpdatedAt DateTime?
  // AES-256-GCM under CLIENT_SECRET_KEY, never plaintext
  totpSecret        String?
  totpConfirmedAt   DateTime?
  suspendedAt       DateTime?
  lastSignInAt      DateTime?
  // Who a visitor should reach while one of this client's sites is down, shown on that site's holding page.
  // The business's name and business details, never the person's own. The client edits them on their
  // account page and the operator on theirs, but they only reach a site while publicContactListed is on,
  // which only the operator can turn on (server/sites/holdingContact.ts sends them to hostd).
  publicName          String?
  publicEmail         String?
  publicPhone         String?
  publicContactListed Boolean   @default(false)
  failedSignIns     Int       @default(0)
  lockedUntil       DateTime?
  quotes            Quote[]
  siteAccess        SiteAccess[]
  sessions          ClientSession[]
  tokens            ClientToken[]
  recoveryCodes     ClientRecoveryCode[]
  totpUses          ClientTotpUse[]
  invoices          Invoice[]
  plans             BillingPlan[]

  @@index([suspendedAt])
}

// A website, on its own. It belongs to nobody: the operator reaches every one of them, and a client reaches one
// only through a SiteAccess row. See docs/superpowers/specs/2026-10-09-site-access-design.md.
model Site {
  id        String       @id @default(cuid())
  // The key in hostd's projects.yaml. hostd is the source of truth; this is a pointer, and a project id the
  // registry doesn't know simply shows as unavailable.
  projectId String       @unique
  name      String
  createdAt DateTime     @default(now())
  access    SiteAccess[]
  plans     BillingPlan[]
}

// What a client may do on a site beyond seeing its Overview, which any access grants. Each one is a tab or a
// control a client can reach today; everything else on a site is the operator's alone, whatever is ticked here.
enum SitePermission {
  // The Logs tab and the Overview's log
  LOGS
  // Start, stop and restart
  LIFECYCLE
  // The Environments tab: each environment's summary and its domains
  ENVIRONMENTS
  // The Deploys tab: the history and a deploy as it runs, never starting one
  DEPLOYS
  // The Backups tab: list, make, delete, download and schedule copies of live
  BACKUPS
  // The Environments tab's Env files: read and edit each environment's env files. Only with ENVIRONMENTS.
  ENV_FILES
}

// One client's access to one site. Many clients may share a site, and a client may have many sites.
model SiteAccess {
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteId      String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  permissions SitePermission[]
  createdAt   DateTime         @default(now())

  @@id([siteId, clientId])
  @@index([clientId])
}

model ClientSession {
  id         String    @id @default(cuid())
  // SHA-256 of the cookie value, so reading this table doesn't let anyone resume a session
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  // Null means the second factor is still outstanding. requireClient() demands this, which is what makes
  // mandatory 2FA a property of the data rather than a check someone can forget.
  mfaAt      DateTime?
  userAgent  String?
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String

  @@index([clientId])
  @@index([expiresAt])
}

model ClientToken {
  id        String             @id @default(cuid())
  tokenHash String             @unique
  purpose   ClientTokenPurpose
  createdAt DateTime           @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String

  @@index([clientId, purpose])
}

model ClientRecoveryCode {
  // HMAC-SHA256 under CLIENT_SECRET_KEY. A fast hash is sound here because we generate the codes at full
  // entropy, unlike a password someone chose.
  id       String    @id @default(cuid())
  codeHash String
  usedAt   DateTime?
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@index([clientId])
}

// A TOTP code that has already been accepted. Replay is refused by the composite key rather than by a lookup,
// so there is no window between checking and recording.
model ClientTotpUse {
  clientId String
  step     BigInt
  usedAt   DateTime @default(now())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, step])
  @@index([usedAt])
}

// Sign-in attempts per IP. In the database rather than in memory so a restart doesn't reset the window, matching
// the quote rate limit. Written for every failed sign-in, every failed second factor, and every reset request
// whether or not it matched a client, because a reset that finds nothing is not a failure the person can see.
model ClientAuthAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// The admin Logs page's tables. Written by server/audit, read only by the operator. Going forward only: nothing
// before the migration that created them is in here.

enum AuditActor {
  // The operator, signed in with Google
  ADMIN
  // A client, signed in to the portal
  CLIENT
  // Somebody not signed in: a quote, a sign-in that failed, a reset asked for
  VISITOR
  // Nobody at all: the billing run raising a plan's invoice or sending a reminder, or PayPal telling us a
  // payment arrived
  SYSTEM
}

// One thing somebody did. The kind is a dotted name from server/audit/kinds.ts rather than an enum, so adding a
// kind is a code change and never a migration.
model AuditEvent {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  kind       String
  actorType  AuditActor
  // The operator's email, or the client's id. Null for a visitor.
  actorId    String?
  // Who they were when it happened, kept because a client can be renamed or deleted afterwards
  actorName  String?
  // The hostd project id, when this is about a site
  site       String?
  // What it was done to, beside the site: a client, a quote, an environment, a domain
  targetType String?
  targetId   String?
  targetName String?
  // One sentence, written when it happened
  summary    String
  // Anything else worth keeping, never a secret: an env file's variable names, never its values
  detail     Json?

  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([actorId, createdAt])
  @@index([site, createdAt])
}

// Every email the site has tried to send, as it was sent. The links in invites and resets are kept without their
// token (server/audit/emails.ts), so this table can never be used to finish somebody else's sign-up or reset.
model SentEmail {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  from      String
  to        String
  replyTo   String
  subject   String
  text      String
  html      String
  // Null when the relay took it, its reason when it did not
  error     String?

  @@index([createdAt])
  @@index([to, createdAt])
}

// The invoicing feature's tables. See docs/superpowers/specs/2026-10-10-invoicing-design.md. Every amount is
// whole cents, so nothing is ever rounded twice.

enum InvoiceStatus {
  // Being written. Only the operator sees it, and it has no number yet.
  DRAFT
  // Sent and waiting to be paid. Due or overdue is read from dueOn when it is shown, never stored.
  OPEN
  PAID
  // Cancelled after it was sent. Kept, number and all, because a sent invoice never disappears.
  VOID
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  // Paid once, through PayPal's checkout
  PAYPAL
  // Taken by a PayPal subscription the client set up
  PAYPAL_AUTOPAY
  // Marked paid by the operator: a bank transfer, cash, anything outside PayPal
  MANUAL
}

model Invoice {
  id                  String         @id @default(cuid())
  // Given when it is sent, from InvoiceCounter, so a deleted draft never leaves a gap in the numbers
  number              Int?           @unique
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  status              InvoiceStatus  @default(DRAFT)
  // SetNull, not Cascade: an invoice is a record of money and outlives the account it was sent to
  client              Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId            String?
  // Who it is addressed to, copied from the client while it is a draft and frozen once it is sent, so a
  // renamed or deleted client never changes an invoice they have already been given
  billToName          String
  billToCompany       String?
  billToEmail         String
  currency            String         @default("AUD")
  // Calendar days, in Brisbane. issuedOn is set when it is sent.
  issuedOn            DateTime?      @db.Date
  dueOn               DateTime       @db.Date
  notes               String?
  // Whether GST was charged, kept per invoice so registering for GST later never rewrites an old one
  gst                 Boolean        @default(false)
  // Kept in step with the lines by server/invoices/repo.ts, so a list never adds them up again
  subtotalCents       Int            @default(0)
  gstCents            Int            @default(0)
  totalCents          Int            @default(0)
  // The plan and period it bills, when a plan raised it
  plan                BillingPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId              String?
  periodStart         DateTime?      @db.Date
  periodEnd           DateTime?      @db.Date
  sentAt              DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?
  // The reminder a few days before it is due, and the notices after
  reminderSentAt      DateTime?
  overdueNotices      Int            @default(0)
  lastOverdueNoticeAt DateTime?
  lines               InvoiceLine[]
  payments            InvoicePayment[]

  @@index([status, dueOn])
  @@index([clientId, createdAt])
  @@index([planId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  position    Int
  description String
  // A float because an hour and a half is 1.5. The schema allows two decimal places at most, and the
  // amount is rounded to whole cents once, here, so the float never reaches a total.
  quantity    Float
  unitCents   Int
  amountCents Int

  @@index([invoiceId, position])
}

model InvoicePayment {
  id          String        @id @default(cuid())
  createdAt   DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  method      PaymentMethod
  amountCents Int
  // PayPal's id for the money that moved: a capture for a checkout, a sale for a subscription. Unique, so a
  // payment PayPal tells us about twice (the return from checkout and the webhook both) is kept once.
  paypalId    String?       @unique
  // live or sandbox, so a test payment is never mistaken for money
  paypalMode  String?
  note        String?
  refundedAt  DateTime?

  @@index([invoiceId])
}

// The next invoice number. One row, taken and advanced in the same statement when an invoice is sent.
model InvoiceCounter {
  id   Int @id @default(1)
  next Int
}

// A recurring charge, such as monthly hosting. Each period raises an invoice on its own, unless the client
// pays it automatically through PayPal, when each payment raises one already paid.
model BillingPlan {
  id                 String          @id @default(cuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId           String
  // The site it is for, when it is for one. Only a label: nothing about the site depends on it.
  site               Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  siteId             String?
  // The line on each invoice, such as "Website hosting"
  description        String
  // Zero is a plan that is not charged: listed, and never invoiced
  amountCents        Int
  interval           BillingInterval @default(MONTHLY)
  startsOn           DateTime        @db.Date
  // How many periods have been billed, by invoice or by automatic payment. The next is period number
  // this, counted from startsOn, which is how a plan started on the 31st still bills on the last day of
  // a short month without drifting to the 28th for ever after.
  periodsBilled      Int             @default(0)
  dueDays            Int             @default(14)
  endedAt            DateTime?
  // PayPal's side of automatic payment, made the first time the client asks for it. All of it belongs to
  // the PayPal mode in paypalMode: a sandbox plan means nothing to live PayPal.
  paypalMode         String?
  paypalProductId    String?
  paypalPlanId       String?
  // The price the PayPal plan carries, so a change here knows to update it there
  paypalPlanCents    Int?
  subscriptionId     String?         @unique
  // PayPal's own word for it: APPROVAL_PENDING, APPROVED, ACTIVE, SUSPENDED, CANCELLED or EXPIRED
  subscriptionStatus String?
  invoices           Invoice[]

  @@index([clientId])
  @@index([endedAt])
}
