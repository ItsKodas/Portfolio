{
  "name": "horizons",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "scene": "node scripts/scene.mjs",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "services": "docker compose -f docker-compose.dev.yml up -d",
    "wallpaper": "node scripts/wallpaper.mjs",
    "wallpaper:serve": "node scripts/wallpaper.mjs --serve"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "6.4.0",
    "@mui/material": "6.4.0",
    "@mui/material-nextjs": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-spring/web": "9.7.5",
    "dotenv": "18.0.1",
    "next": "^15.5.9",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.5",
    "postcss": "^8",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
